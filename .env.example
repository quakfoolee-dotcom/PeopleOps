APP_ENV=development
APP_RELEASE_SHA=local
LOG_LEVEL=INFO
POLICY_CORPUS_DIRECTORY=policy_corpus
RAG_INDEX_PATH=policy_corpus/index/phase5_index.json
RAG_EMBEDDING_DIMENSIONS=384
RAG_CHUNK_TARGET_WORDS=240
RAG_CHUNK_OVERLAP_WORDS=40
RAG_TOP_K=8
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# Use "not-configured" for deterministic-only local development, "deterministic"
# for CI, or "openrouter" for the hosted provider adapter.
LLM_PROVIDER=not-configured
LLM_MODEL=openrouter/free
LLM_BASE_URL=https://openrouter.ai/api/v1
# Set this secret in the shell or hosting dashboard; never commit a real value.
OPENROUTER_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=700
LLM_TEMPERATURE=0
LLM_HEALTH_CACHE_SECONDS=60
LLM_HTTP_REFERER=http://127.0.0.1:8000
LLM_APP_TITLE=PeopleOps Assistant
MAX_TOOL_CALLS=10
TOOL_TIMEOUT_SECONDS=20
MCP_CONFIRMATION_SECRET=peopleops-local-demo-confirmation-secret
MCP_CONFIRMATION_TTL_SECONDS=900
SYNTHETIC_AS_OF_DATE=2026-09-01
