{
  "$defs": {
    "AttachmentContext": {
      "additionalProperties": false,
      "properties": {
        "extracted_text": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Extracted Text",
          "type": "string"
        },
        "filename": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^/\\\\\\x00-\\x1f]+$",
          "title": "Filename",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "text/plain",
            "text/markdown",
            "application/pdf"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "original_size_bytes": {
          "maximum": 2000000,
          "minimum": 1,
          "title": "Original Size Bytes",
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "filename",
        "media_type",
        "extracted_text",
        "original_size_bytes"
      ],
      "title": "AttachmentContext",
      "type": "object"
    },
    "UseCaseHint": {
      "enum": [
        "auto",
        "remote_work",
        "pto",
        "expense",
        "benefits_policy",
        "workplace_concern"
      ],
      "title": "UseCaseHint",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of_date": {
      "default": "2026-09-01",
      "format": "date",
      "title": "As Of Date",
      "type": "string"
    },
    "attachment": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttachmentContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confirmation_token": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 16,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmation Token"
    },
    "employee_id": {
      "anyOf": [
        {
          "pattern": "^E-\\d{4}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Employee Id"
    },
    "message": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "use_case": {
      "$ref": "#/$defs/UseCaseHint",
      "default": "auto"
    }
  },
  "required": [
    "message"
  ],
  "title": "ChatRequest",
  "type": "object"
}
