{
  "additionalProperties": false,
  "properties": {
    "content_base64": {
      "maxLength": 2700000,
      "minLength": 4,
      "title": "Content Base64",
      "type": "string"
    },
    "filename": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[^/\\\\\\x00-\\x1f]+$",
      "title": "Filename",
      "type": "string"
    },
    "media_type": {
      "enum": [
        "text/plain",
        "text/markdown",
        "application/pdf"
      ],
      "title": "Media Type",
      "type": "string"
    }
  },
  "required": [
    "filename",
    "media_type",
    "content_base64"
  ],
  "title": "AttachmentUploadRequest",
  "type": "object"
}
